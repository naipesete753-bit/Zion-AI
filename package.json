{
  "name": "zion-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zion AI — agente conversacional com arquitetura pronta para provedores de IA e serviços gratuitos.",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node --watch server.mjs",
    "build": "vite build",
    "start": "node server.mjs",
    "check": "npm run build",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "apk:debug": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.3"
  }
}
