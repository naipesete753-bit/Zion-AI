# Escolha um provedor. Nunca exponha estas chaves no cliente.
# OPENROUTER_API_KEY=sk-or-...
# GROQ_API_KEY=gsk_...

# Opcional: URL pública usada nos cabeçalhos do OpenRouter
# PUBLIC_APP_URL=https://seu-dominio.example

# Produção / APK: origens permitidas pela API, separadas por vírgula.
# APP_ALLOWED_ORIGINS=https://app.seu-dominio.example,capacitor://localhost

# Build APK: endpoint HTTPS do backend (esta variável é pública e não recebe chaves).
# VITE_API_BASE_URL=https://api.seu-dominio.example

# Opcional: porta da API local
# PORT=8787
